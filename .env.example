# 抽奖配置示例。复制为 .env 或 .env.local 后修改。
# .env.local 优先级高于 .env

# 抽奖文件所在目录（绝对路径或相对运行目录）。
# 支持多个目录，用逗号分隔，例如：LOTTERY_DIR=./gold,./silver,./bronze
LOTTERY_DIR=./prizes

# 文件类型预设，逗号分隔。可选：image, video, audio, text, doc
# 与 LOTTERY_EXTENSIONS 取并集；两者都留空时默认 image,video,text
LOTTERY_TYPES=image,video,text

# 自定义文件后缀集合，逗号分隔（不含点）。与 LOTTERY_TYPES 取并集。
LOTTERY_EXTENSIONS=

# 一共抽几个奖（从低奖到高奖依次抽取）
AWARD_COUNT=3

# 服务端口
PORT=8787
